          "rawSql": "SELECT cohort_date, concat('Day ', toString(day_number)) AS day_number, argMax(retention_percent, calculated_at) AS retention_percent FROM online_cinema.retention_agg WHERE report_date >= today() - 30 GROUP BY cohort_date, day_number ORDER BY cohort_date, day_number",
