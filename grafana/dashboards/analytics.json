            "uid": "clickhouse"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "WITH latest_date AS (SELECT max(date) AS d FROM online_cinema.top_movies_agg) SELECT movie_id, argMax(views_count, calculated_at) AS views FROM online_cinema.top_movies_agg WHERE date = (SELECT d FROM latest_date) GROUP BY movie_id ORDER BY views DESC LIMIT 10",
